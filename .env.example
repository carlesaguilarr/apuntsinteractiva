# Variables d'entorn per configurar a Vercel (Project Settings -> Environment Variables)
# Token de GitHub (Fine-grained PAT recomanat amb permís a carlesaguilarr/Vault: Issues Read & Write + Contents Read & Write)
GITHUB_TOKEN=

# Opcionals (per defecte apunten a carlesaguilarr/Vault)
VAULT_OWNER=carlesaguilarr
VAULT_REPO=Vault
